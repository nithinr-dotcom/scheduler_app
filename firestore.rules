rules_version = '2';

// Single-user app: each signed-in user can only touch their own users/{uid} tree.
// To lock the whole project to just you, replace YOUR_UID with your Firebase Auth uid
// (Firebase console → Authentication → Users) and use the stricter rule below.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // allow read, write: if request.auth != null && request.auth.uid == uid && uid == "YOUR_UID";
    }
  }
}
